# API（P0-11: 与后端实际端口 8080 对齐；留空=同源，开发由 vite proxy 转发）
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# App
VITE_APP_TITLE=ClipWright
VITE_APP_VERSION=0.1.0

# Feature flags
VITE_ENABLE_AGENT=true
VITE_ENABLE_PERSONA_MARKET=true
VITE_ENABLE_PLUGIN_MARKET=true
VITE_ENABLE_TELEMETRY=false

# Performance
VITE_MAX_THUMBNAIL_CACHE_SIZE=500
VITE_MAX_UNDO_HISTORY=200
VITE_MAX_CONCURRENT_UPLOADS=3
