# ═══════════════════════════════════════════════════════════
# 帧艺 ClipWright 后端环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量均以 CLIPWRIGHT_ 为前缀。
#
# 提示：绝大多数配置项也可以在「设置 → 后端配置」页修改
# （落盘 settings.json，优先级高于本文件）；标注「需重启」的项
# （CORS/Mongo/端口/路径/并发渲染等）只在启动时读取一次。
# ═══════════════════════════════════════════════════════════

# ── 服务 ──
CLIPWRIGHT_HOST=0.0.0.0
CLIPWRIGHT_PORT=8080
CLIPWRIGHT_DEBUG=false

# ── 安全（生产部署必填） ──
# API 令牌：设置后所有 /api/* 请求需携带 Authorization: Bearer <token>
# 留空为开发模式（API 开放访问，启动时打印警告）
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIPWRIGHT_API_TOKEN=
# CORS 允许来源（逗号分隔），仅在 CLIPWRIGHT_API_TOKEN 设置后生效
CLIPWRIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 安全红线：绑定非回环地址且无任何鉴权配置时启动会被拒绝（fail-closed）；
# 仅受控本地/内网环境可显式置 true 自认风险
CLIPWRIGHT_ALLOW_INSECURE=false

# ── 账号管理（P3） ──
# verify_mode: off | token | jwt（off=不校验；jwt=本地验签 Server 签发 JWT）
CLIPWRIGHT_ACCOUNT_VERIFY_MODE=off
# ClipWright Server 地址（市场 API / 未来 token 模式 /verify）
CLIPWRIGHT_ACCOUNT_URL=
# 与 K:\Clipwright Server 共享的 JWT 密钥（jwt 模式必填）
CLIPWRIGHT_ACCOUNT_JWT_SECRET=
CLIPWRIGHT_ACCOUNT_JWT_ALGORITHM=HS256

# ── 速率限制（进程内滑动窗口） ──
CLIPWRIGHT_RATE_LIMIT_ENABLED=true
CLIPWRIGHT_RATE_LIMIT_WINDOW_SEC=60
CLIPWRIGHT_RATE_LIMIT_MAX_REQUESTS=120

# ── LLM 成本预算（全局月 token 预算；0=不限） ──
CLIPWRIGHT_LLM_MONTHLY_TOKEN_BUDGET=0

# ── Webhook（P8：secret 落盘加密；缺省用 ACCOUNT_JWT_SECRET 派生） ──
# Fernet key（base64 urlsafe 32 bytes）；空则用 jwt secret 派生 sha256
CLIPWRIGHT_WEBHOOK_SECRET_KEY=

# ── 插件治理（P10） ──
# manifest 签名密钥；空则从 ACCOUNT_JWT_SECRET 派生；再为空则不强制签名
CLIPWRIGHT_PLUGIN_SIGNATURE_KEY=
# true 时未签名插件拒绝加载（市场开放前最低安全线）
CLIPWRIGHT_PLUGIN_REQUIRE_SIGNATURE=false
# 已知权限白名单（逗号分隔）
CLIPWRIGHT_PLUGIN_ALLOWED_PERMISSIONS=network,fs_read,fs_write,shell,http,noop

# ── MongoDB ──
CLIPWRIGHT_MONGO_URI=mongodb://localhost:27017
CLIPWRIGHT_MONGO_DB_NAME=clipwright

# ── LLM ──
# provider: anthropic | openai | ollama
CLIPWRIGHT_LLM_PROVIDER=openai
CLIPWRIGHT_LLM_API_KEY=
CLIPWRIGHT_LLM_MODEL=
# OpenAI 兼容 API 的 base_url（Ollama: http://localhost:11434/v1, vLLM: ...）
CLIPWRIGHT_LLM_BASE_URL=
CLIPWRIGHT_LLM_INSTRUCTIONS=You are ClipWright, an AI video content orchestration engine.
# ── Flash 模型（轻量快速，用于意图判断/确认分类/搜索等简单任务）──
# 主模型保留给复杂生成；不配置时复用主模型的 provider/key/base_url。
CLIPWRIGHT_LLM_FLASH_MODEL=
#CLIPWRIGHT_LLM_FLASH_PROVIDER=
#CLIPWRIGHT_LLM_FLASH_API_KEY=
#CLIPWRIGHT_LLM_FLASH_BASE_URL=

# ── 视觉识别 ──
# provider: llm | transformers | none
CLIPWRIGHT_VISION_PROVIDER=transformers
CLIPWRIGHT_VISION_MODEL=google/vit-base-patch16-224
CLIPWRIGHT_VISION_TOP_K=5
CLIPWRIGHT_VISION_DEVICE=cpu
# 视觉 LLM 独立配置（不配置时复用主 LLM 参数）
# CLIPWRIGHT_VISION_LLM_PROVIDER=
# CLIPWRIGHT_VISION_LLM_MODEL=
# CLIPWRIGHT_VISION_LLM_API_KEY=
# CLIPWRIGHT_VISION_LLM_BASE_URL=

# ── RAG / Embedding ──
# provider: sentence_transformer | openai | ollama
CLIPWRIGHT_RAG_EMBED_PROVIDER=sentence_transformer
CLIPWRIGHT_RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
CLIPWRIGHT_RAG_EMBED_DIM=512
# CLIPWRIGHT_RAG_EMBED_API_KEY=
# CLIPWRIGHT_RAG_EMBED_BASE_URL=
CLIPWRIGHT_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# CLIPWRIGHT_RAG_RERANK_BASE_URL=
# CLIPWRIGHT_RAG_RERANK_API_KEY=
CLIPWRIGHT_RAG_TOP_K=5
CLIPWRIGHT_RAG_RERANK_TOP_K=20
CLIPWRIGHT_RAG_CHUNK_SIZE=512
CLIPWRIGHT_RAG_CHUNK_OVERLAP=64
CLIPWRIGHT_RAG_EMBED_BATCH_SIZE=20

# ── 渲染 ──
CLIPWRIGHT_MAX_CONCURRENT_RENDERS=2
# 编码器: libx264 / h264_nvenc / hevc_nvenc / hevc_amf
CLIPWRIGHT_RENDER_ENCODER=libx264
# 预设: ultrafast / fast / medium / slow
CLIPWRIGHT_RENDER_PRESET=medium
# 字幕渲染器: ass = libass（14 个样式字段生效）| drawtext = 旧滤镜回退
CLIPWRIGHT_CAPTION_RENDERER=ass
# 成片输出目录（默认 renders；改后需重启使静态挂载生效）
#CLIPWRIGHT_RENDER_OUTPUT_DIR=renders
# 裁剪缓存开关（当前版本未接线，预留）
CLIPWRIGHT_RENDER_TRIM_CACHE=true
# ffmpeg/ffprobe 路径（留空自动探测 PATH 及常见安装位置）
CLIPWRIGHT_FFMPEG_PATH=
CLIPWRIGHT_FFPROBE_PATH=
# 远程渲染服务地址（留空表示仅本地渲染）
CLIPWRIGHT_REMOTE_RENDER_URL=http://localhost:8100
# 远程渲染服务鉴权令牌
CLIPWRIGHT_REMOTE_RENDER_TOKEN=
# 远程渲染不可用时是否回退本地渲染
CLIPWRIGHT_REMOTE_RENDER_FALLBACK=true
# 远程渲染轮询间隔（秒）
CLIPWRIGHT_REMOTE_RENDER_POLL_INTERVAL=1.5
# 远程渲染超时（秒）
CLIPWRIGHT_REMOTE_RENDER_TIMEOUT=1800
# 远程渲染产物下载上限（MB）
CLIPWRIGHT_REMOTE_RENDER_MAX_DOWNLOAD_MB=4096
# 轮询连续瞬态失败容忍次数
CLIPWRIGHT_REMOTE_RENDER_POLL_MAX_FAILURES=3

# ── 管线与素材 ──
# MG 动画逐片段 LLM 生成并发路数（1 = 串行）
CLIPWRIGHT_PIPELINE_CONCURRENCY=6
# 素材阶段场景级并行路数（1 = 串行）
CLIPWRIGHT_MATERIAL_CONCURRENCY=6
# 素材帧验证启用视觉 LLM（产生视觉 API 成本）
CLIPWRIGHT_ENABLE_VISUAL_LLM=false
# 结构 Agent 配音双稿择优（双倍 LLM 调用）
CLIPWRIGHT_STRUCTURE_DOUBLE_DRAFT=false
# 全局素材库目录（无 project_id 上传的落点）
CLIPWRIGHT_LIBRARY_DIR=library

# ── 联网搜索（Bocha 主 / 百度备）──
# 兼容无前缀写法：ENABLE_WEB_SEARCH / WEB_SEARCH_PROVIDER 等
CLIPWRIGHT_ENABLE_WEB_SEARCH=false
CLIPWRIGHT_WEB_SEARCH_PROVIDER=bocha
CLIPWRIGHT_WEB_SEARCH_API_KEY=
#CLIPWRIGHT_WEB_SEARCH_BASE_URL=
CLIPWRIGHT_WEB_SEARCH_TIMEOUT=15
CLIPWRIGHT_WEB_SEARCH_MAX_RESULTS=5

# ── 存储与路径（改后需重启）──
#CLIPWRIGHT_PERSONA_DIR=personas
#CLIPWRIGHT_PLUGIN_DIR=plugins
#CLIPWRIGHT_PLUGIN_DATA_DIR=PluginData
#CLIPWRIGHT_PROJECT_DIR=projects

# ── TTS / 声音克隆（阿里云百炼 DashScope） ──
CLIPWRIGHT_TTS_DASHSCOPE_API_KEY=
CLIPWRIGHT_TTS_WORKSPACE_ID=
# 默认音色 provider: qwen-tts | cosyvoice | minimax
CLIPWRIGHT_TTS_DEFAULT_PROVIDER=qwen-tts
CLIPWRIGHT_TTS_QWEN_MODEL=qwen3-tts-vc-2026-01-22
CLIPWRIGHT_TTS_COSYVOICE_MODEL=cosyvoice-v3.5-plus
CLIPWRIGHT_TTS_MINIMAX_MODEL=MiniMax/speech-2.8-turbo
# 公网上传服务（仅 CosyVoice / MiniMax 克隆需要公网音频 URL）
CLIPWRIGHT_TTS_PUBLIC_UPLOAD_SERVICES=uguu,catbox
# 音色元数据 / 合成音频 / 克隆样本存储路径（合成音频目录改后需重启）
#CLIPWRIGHT_TTS_VOICE_DB=PluginData/voices/voices.json
#CLIPWRIGHT_TTS_OUTPUT_DIR=PluginData/voices/audio
#CLIPWRIGHT_TTS_UPLOAD_DIR=PluginData/voices/uploads

# ── AI 生成插件（火山引擎） ──
# ai_image_gen / ai_video_gen（火山方舟 Ark，Bearer API Key）
# https://console.volcengine.com/ark → API Key 管理；模型需在方舟控制台开通
ARK_API_KEY=
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#ARK_SEEDREAM_MODEL=doubao-seedream-4-0-250828
#ARK_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
# ai_music_gen（火山引擎「音视频理解与处理」豆包音乐大模型，AK/SK V4 签名）
# https://console.volcengine.com → 访问控制 AK/SK；需开通 AI 音乐生成服务
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
