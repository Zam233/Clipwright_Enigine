# ═══════════════════════════════════════════════════════════
# 帧艺 ClipWright 后端环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量均以 CLIPWRIGHT_ 为前缀。
# ═══════════════════════════════════════════════════════════

# ── 服务 ──
CLIPWRIGHT_HOST=0.0.0.0
CLIPWRIGHT_PORT=8000
CLIPWRIGHT_DEBUG=false

# ── 安全（生产部署必填） ──
# API 令牌：设置后所有 /api/* 请求需携带 Authorization: Bearer <token>
# 留空为开发模式（API 开放访问，启动时打印警告）
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIPWRIGHT_API_TOKEN=
# CORS 允许来源（逗号分隔），仅在 CLIPWRIGHT_API_TOKEN 设置后生效
CLIPWRIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── MongoDB ──
CLIPWRIGHT_MONGO_URI=mongodb://localhost:27017
CLIPWRIGHT_MONGO_DB_NAME=clipwright

# ── LLM ──
# provider: anthropic | openai | ollama
CLIPWRIGHT_LLM_PROVIDER=openai
CLIPWRIGHT_LLM_API_KEY=
CLIPWRIGHT_LLM_MODEL=
# OpenAI 兼容 API 的 base_url（Ollama: http://localhost:11434/v1, vLLM: ...）
CLIPWRIGHT_LLM_BASE_URL=
CLIPWRIGHT_LLM_INSTRUCTIONS=You are ClipWright, an AI video content orchestration engine.
# ── Flash 模型（轻量快速，用于意图判断/确认分类/搜索等简单任务）──
# 主模型保留给复杂生成；不配置时复用主模型的 provider/key/base_url。
CLIPWRIGHT_LLM_FLASH_MODEL=
#CLIPWRIGHT_LLM_FLASH_PROVIDER=
#CLIPWRIGHT_LLM_FLASH_API_KEY=
#CLIPWRIGHT_LLM_FLASH_BASE_URL=

# ── 视觉识别 ──
# provider: llm | transformers | none
CLIPWRIGHT_VISION_PROVIDER=transformers
CLIPWRIGHT_VISION_MODEL=google/vit-base-patch16-224
# 视觉 LLM 独立配置（不配置时复用主 LLM 参数）
# CLIPWRIGHT_VISION_LLM_PROVIDER=
# CLIPWRIGHT_VISION_LLM_MODEL=
# CLIPWRIGHT_VISION_LLM_API_KEY=
# CLIPWRIGHT_VISION_LLM_BASE_URL=

# ── RAG / Embedding ──
# provider: sentence_transformer | openai | ollama
CLIPWRIGHT_RAG_EMBED_PROVIDER=sentence_transformer
CLIPWRIGHT_RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
CLIPWRIGHT_RAG_EMBED_DIM=512
# CLIPWRIGHT_RAG_EMBED_API_KEY=
# CLIPWRIGHT_RAG_EMBED_BASE_URL=
CLIPWRIGHT_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# CLIPWRIGHT_RAG_RERANK_BASE_URL=
# CLIPWRIGHT_RAG_RERANK_API_KEY=
CLIPWRIGHT_RAG_TOP_K=5
CLIPWRIGHT_RAG_RERANK_TOP_K=20
CLIPWRIGHT_RAG_CHUNK_SIZE=512
CLIPWRIGHT_RAG_CHUNK_OVERLAP=64
CLIPWRIGHT_RAG_EMBED_BATCH_SIZE=20

# ── 渲染 ──
CLIPWRIGHT_MAX_CONCURRENT_RENDERS=2
# 编码器: libx264 / h264_nvenc / hevc_nvenc / hevc_amf
CLIPWRIGHT_RENDER_ENCODER=libx264
# 预设: ultrafast / fast / medium / slow
CLIPWRIGHT_RENDER_PRESET=medium
# 远程渲染服务地址（留空表示仅本地渲染）
CLIPWRIGHT_REMOTE_RENDER_URL=http://localhost:8100
# 远程渲染服务鉴权令牌
CLIPWRIGHT_REMOTE_RENDER_TOKEN=
# 远程渲染不可用时是否回退本地渲染
CLIPWRIGHT_REMOTE_RENDER_FALLBACK=true
# 远程渲染轮询间隔（秒）
CLIPWRIGHT_REMOTE_RENDER_POLL_INTERVAL=1.5
# 远程渲染超时（秒）
CLIPWRIGHT_REMOTE_RENDER_TIMEOUT=1800

# ── TTS / 声音克隆（阿里云百炼 DashScope） ──
CLIPWRIGHT_TTS_DASHSCOPE_API_KEY=
CLIPWRIGHT_TTS_WORKSPACE_ID=
# 默认音色 provider: qwen-tts | cosyvoice | minimax
CLIPWRIGHT_TTS_DEFAULT_PROVIDER=qwen-tts
CLIPWRIGHT_TTS_QWEN_MODEL=qwen3-tts-vc-2026-01-22
CLIPWRIGHT_TTS_COSYVOICE_MODEL=cosyvoice-v3.5-plus
CLIPWRIGHT_TTS_MINIMAX_MODEL=MiniMax/speech-2.8-turbo
# 公网上传服务（仅 CosyVoice / MiniMax 克隆需要公网音频 URL）
CLIPWRIGHT_TTS_PUBLIC_UPLOAD_SERVICES=uguu,catbox
