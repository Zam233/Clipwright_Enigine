{
  "animation_id": "mg_title_reveal",
  "name": "标题揭示",
  "category": "mg",
  "description": "标题文字从中心放大 + 光效扫过，适合开场标题展示",
  "duration_sec": 3.0,
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "type": "text",
      "id": "title",
      "content": "{text}",
      "font_size": 72,
      "font_color": "#ffffff",
      "font_weight": "bold",
      "x": "center",
      "y": "center",
      "keyframes": [
        {"time": 0.0, "scale": 0.0, "opacity": 0, "rotate": -15},
        {"time": 0.5, "scale": 1.15, "opacity": 1, "rotate": 0},
        {"time": 0.8, "scale": 1.0, "opacity": 1, "rotate": 0},
        {"time": 2.5, "scale": 1.0, "opacity": 1, "rotate": 0},
        {"time": 3.0, "scale": 1.05, "opacity": 0.8, "rotate": 0}
      ]
    },
    {
      "type": "shape",
      "id": "glow_line",
      "shape": "rect",
      "x": "center",
      "y": "center_offset",
      "width": 0,
      "height": 4,
      "color": "#4f8cff",
      "y_offset": 60,
      "keyframes": [
        {"time": 0.3, "width": 0, "opacity": 0},
        {"time": 0.8, "width": 400, "opacity": 1},
        {"time": 2.5, "width": 400, "opacity": 1},
        {"time": 3.0, "width": 300, "opacity": 0.5}
      ]
    },
    {
      "type": "shape",
      "id": "light_sweep",
      "shape": "rect",
      "x": "left",
      "y": "top",
      "width": 200,
      "height": "full",
      "color": "rgba(255,255,255,0.08)",
      "keyframes": [
        {"time": 0.0, "x_offset": -200, "opacity": 0},
        {"time": 0.3, "x_offset": -200, "opacity": 1},
        {"time": 0.8, "x_offset": 2200, "opacity": 1},
        {"time": 1.0, "x_offset": 2200, "opacity": 0}
      ]
    }
  ],
  "style": {
    "background": "rgba(0,0,0,0)",
    "font_family": "sans-serif"
  }
}
