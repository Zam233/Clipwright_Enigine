{
  "animation_id": "mg_logo_intro",
  "name": "Logo 展示",
  "category": "mg",
  "description": "Logo/图标从底部弹入 + 光环扩散，适合品牌展示",
  "duration_sec": 2.5,
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "type": "shape",
      "id": "ring",
      "shape": "ellipse",
      "x": "center",
      "y": "center",
      "width": 100,
      "height": 100,
      "color": "#4f8cff",
      "stroke_width": 3,
      "fill_opacity": 0,
      "keyframes": [
        {"time": 0.0, "scale": 0.0, "opacity": 0.8},
        {"time": 0.6, "scale": 1.5, "opacity": 0},
        {"time": 0.0, "scale": 0.0, "opacity": 0.8},
        {"time": 0.6, "scale": 1.5, "opacity": 0}
      ]
    },
    {
      "type": "text",
      "id": "logo_text",
      "content": "{text}",
      "font_size": 48,
      "font_color": "#ffffff",
      "font_weight": "bold",
      "x": "center",
      "y": "center",
      "keyframes": [
        {"time": 0.0, "opacity": 0, "translate_y": 40},
        {"time": 0.4, "opacity": 0, "translate_y": 40},
        {"time": 0.7, "opacity": 1, "translate_y": 0},
        {"time": 2.0, "opacity": 1, "translate_y": 0},
        {"time": 2.5, "opacity": 0.8, "translate_y": 0}
      ]
    },
    {
      "type": "text",
      "id": "subtitle",
      "content": "{subtitle}",
      "font_size": 24,
      "font_color": "#8888a0",
      "x": "center",
      "y": "center",
      "y_offset": 50,
      "keyframes": [
        {"time": 0.0, "opacity": 0},
        {"time": 0.8, "opacity": 0},
        {"time": 1.2, "opacity": 1},
        {"time": 2.5, "opacity": 1}
      ]
    }
  ],
  "params": {
    "subtitle": {"type": "string", "default": "", "description": "副标题"}
  },
  "style": {
    "background": "rgba(0,0,0,0)",
    "font_family": "sans-serif"
  }
}
