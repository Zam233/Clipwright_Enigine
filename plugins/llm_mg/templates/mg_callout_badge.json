{
  "animation_id": "mg_callout_badge",
  "name": "标注徽章",
  "description": "带彩色圆点的标注徽章，适合标注关键信息/特征标签",
  "duration_sec": 2.0,
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "type": "shape",
      "shape": "ellipse",
      "color": "{accent}",
      "x": "center",
      "y": "center",
      "y_offset": -80,
      "width": 16,
      "height": 16,
      "keyframes": [
        {"time": 0, "opacity": 0, "scale": 0},
        {"time": 0.3, "opacity": 1, "scale": 1.3},
        {"time": 0.5, "opacity": 1, "scale": 1.0}
      ]
    },
    {
      "type": "text",
      "content": "{text}",
      "x": "center",
      "y": "center",
      "y_offset": -80,
      "x_offset": 20,
      "font_size": 40,
      "font_color": "#ffffff",
      "font_weight": "bold",
      "keyframes": [
        {"time": 0.1, "opacity": 0, "translate_x": -20},
        {"time": 0.4, "opacity": 1, "translate_x": 0}
      ]
    },
    {
      "type": "text",
      "content": "{value}",
      "x": "center",
      "y": "center",
      "y_offset": 20,
      "font_size": 24,
      "font_color": "#aaaaaa",
      "font_weight": "normal",
      "keyframes": [
        {"time": 0.5, "opacity": 0, "translate_y": 10},
        {"time": 0.9, "opacity": 0.8, "translate_y": 0}
      ]
    }
  ],
  "params": {
    "text": {"type": "string", "default": "核心指标"},
    "value": {"type": "string", "default": ""},
    "accent": {"type": "string", "default": "#fbbf24"}
  },
  "style": {
    "background": "transparent",
    "font_family": "sans-serif"
  }
}
