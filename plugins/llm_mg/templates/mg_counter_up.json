{
  "animation_id": "mg_counter_up",
  "name": "数字滚动",
  "description": "大数字从0滚动到目标值，适合展示统计数据",
  "duration_sec": 2.5,
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "type": "text",
      "content": "{value}{unit}",
      "x": "center",
      "y": "center",
      "y_offset": -100,
      "font_size": 96,
      "font_color": "#ffffff",
      "font_weight": "bold",
      "keyframes": [
        {"time": 0, "opacity": 0, "scale": 0.5},
        {"time": 0.4, "opacity": 1, "scale": 1.2},
        {"time": 0.8, "opacity": 1, "scale": 1.0}
      ]
    },
    {
      "type": "text",
      "content": "{text}",
      "x": "center",
      "y": "center",
      "y_offset": 40,
      "font_size": 36,
      "font_color": "#888888",
      "font_weight": "normal",
      "keyframes": [
        {"time": 0.6, "opacity": 0, "translate_y": 20},
        {"time": 1.2, "opacity": 0.8, "translate_y": 0}
      ]
    }
  ],
  "params": {
    "text": {"type": "string", "default": "总用户数"},
    "value": {"type": "string", "default": "99+"},
    "unit": {"type": "string", "default": ""}
  },
  "style": {
    "background": "transparent",
    "font_family": "Arial, sans-serif"
  }
}
