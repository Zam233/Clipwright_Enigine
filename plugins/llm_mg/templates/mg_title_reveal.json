{
  "animation_id": "mg_title_reveal",
  "name": "标题揭示",
  "description": "大标题从中心放大+淡入出现，带下划线装饰",
  "duration_sec": 3.0,
  "width": 1920,
  "height": 1080,
  "elements": [
    {
      "type": "text",
      "content": "{text}",
      "x": "center",
      "y": "center",
      "y_offset": -60,
      "font_size": 72,
      "font_color": "#ffffff",
      "font_weight": "bold",
      "keyframes": [
        {"time": 0, "opacity": 0, "scale": 0.3},
        {"time": 0.6, "opacity": 1, "scale": 1.1},
        {"time": 1.2, "opacity": 1, "scale": 1.0}
      ]
    },
    {
      "type": "shape",
      "shape": "rect",
      "color": "{accent}",
      "x": "center",
      "y": "center",
      "y_offset": 40,
      "width": 200,
      "height": 3,
      "keyframes": [
        {"time": 0.8, "opacity": 0, "width": 0},
        {"time": 1.5, "opacity": 1, "width": 200}
      ]
    }
  ],
  "params": {
    "text": {"type": "string", "default": "标题"},
    "accent": {"type": "string", "default": "#4f8cff"}
  },
  "style": {
    "background": "transparent",
    "font_family": "sans-serif"
  }
}
