          "easing": "ease-out"
        },
        {
          "time": 1.2,
          "opacity": 1,
          "scale": 1.0
        },
        {
          "time": 3.5,
          "opacity": 1,
          "scale": 1.0
        }
      ],
      "shape": "rect"
    },
    {
      "type": "text",
      "x": 420,
      "y": 430,
      "font_size": 68,
      "color": "#f4f6fb",
      "font_weight": "bold",
      "keyframes": [
        {
          "time": 0,
          "opacity": 0,
          "translate_x": -30,
          "easing": "ease-out"
        },
        {
          "time": 1.5,
          "opacity": 1,
          "translate_x": 0
        },
        {
          "time": 3.5,
          "opacity": 1,
          "translate_x": 0
        }
      ],
      "content": "{title}"
    },
    {
      "type": "text",
      "x": 420,
      "y": 560,
      "font_size": 38,
      "color": "#aab4cc",
