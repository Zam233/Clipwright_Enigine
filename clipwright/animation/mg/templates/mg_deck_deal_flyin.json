          "rotate": 8,
          "easing": "back-out"
        },
        {
          "time": 0.9,
          "opacity": 1,
          "translate_x": 0,
          "rotate": 0
        },
        {
          "time": 3.5,
          "opacity": 1,
          "translate_x": 0,
          "rotate": 0
        }
      ],
      "shape": "rect"
    },
    {
      "type": "shape",
      "x": 400,
      "y": 330,
